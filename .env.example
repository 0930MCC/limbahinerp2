# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Configure in AI Studio Settings -> Secrets)
# Keep these strictly server-side (never prefix with VITE_).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Pre-seed password for initial MCC-1001 master worker (username: limbahinmcc)
# If left unset, an inline first-run Master Setup screen will let you initialize MCC-1001.
INITIAL_MASTER_PASSWORD=
